# Template: the installer replaces @REPO@ with the repo path on the Frame.
[Unit]
Description=Frametop gaze service: the eye tracking, corrected, for the pointer's gaze mode
Documentation=file://@REPO@/gaze/README.md
# Needs SteamVR's IPC (ft-gaze is an overlay client); it starts and stops with SteamVR.
After=steamvr.service frametop-pointer.service
PartOf=steamvr.service
Requisite=steamvr.service

[Service]
# Host Python; it runs ft-gaze in the dev container (distrobox enter), which quits when
# the service's pipe to it closes.
ExecStart=/usr/bin/python3 @REPO@/gaze/ft-gazed
Restart=on-failure
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=steamvr.service
